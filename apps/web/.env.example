# Required for the single-user editor login.
ADMIN_PASSWORD=replace-with-a-long-unique-password
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-characters

# Shared with the Render cron job that prepares each morning's inbox.
CRON_SECRET=replace-with-a-long-random-token

# Public production URL, without a trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional — enables AI-assisted drafting in the admin inbox. Leave unset to
# draft manually; the publish-time originality gate applies either way.
# GEMINI_API_KEY=your-google-ai-studio-key
# GEMINI_MODEL=gemini-3.6-flash

# Production hosts should mount durable storage here. Leave unset locally.
# STORAGE_ROOT=/var/data

# Optional overrides. Normally STORAGE_ROOT is enough.
# DATABASE_PATH=/var/data/data/bitefeed.db
# UPLOAD_DIR=/var/data/uploads
